# Public production URL of this deployment
NEXT_PUBLIC_APP_URL=https://trading-flow-capital.vercel.app
NEXT_PUBLIC_APP_NAME=Trading Flow

# Optional Google Search Console HTML verification token
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-token

# Gemini AI support assistant (server-side only)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Use a random value of at least 32 characters
JWT_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-at-least-32-random-characters

# Keep demo accounts disabled in production
ENABLE_DEMO_ACCOUNTS=false

# First admin account created automatically when the database has no admin.
# ADMIN_PASSWORD must be at least 12 characters.
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=replace-with-a-long-private-password
ADMIN_NAME=Platform Admin

# APK build target. This must be the public HTTPS deployment URL.
APP_URL=https://trading-flow-capital.vercel.app

# Optional JSON fallback path. Used only when DATABASE_URL is not set.
# DB_FILE=.data/db.json

# Supabase PostgreSQL (Session Pooler). Required for durable production storage.
# Copy the full connection string from Supabase Project Settings -> Database.
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
